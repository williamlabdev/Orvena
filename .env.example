# Copy to .env and fill the key for the provider you selected in `orvena init`.
# Never commit .env. Orvena reads only the key for your chosen provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# `ollama` and `offline` providers need no key.
# `openai_compat` (generic OpenAI-compatible endpoint — vLLM, llama.cpp server,
# LM Studio, TGI, Groq, Together, ...) has no fixed var name: set `api_key_env`
# in orvena.yaml to whatever var you add here (e.g. GROQ_API_KEY=...), or leave
# it unset if the endpoint needs no auth at all.
